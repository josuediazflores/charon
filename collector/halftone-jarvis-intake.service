[Unit]
Description=Split submitted overnight plans with Codex
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/halftone-collector/jarvis-paused.json

[Service]
Type=oneshot
User=pi
Group=pi
ExecStart=/usr/bin/python3 -u /home/pi/halftone-chat/bin/jarvis-job-runner.py --intake
TimeoutStartSec=7200
Nice=15
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=yes
