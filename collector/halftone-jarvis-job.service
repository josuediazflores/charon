# Copy to /etc/systemd/system/. Started by halftone-jarvis-job.path, never
# enabled itself: enabling this would run a drain at every boot whether or not
# anything is waiting.
#
# This is the work lane. Its whole reason for being a separate unit from
# halftone-jarvis-say.service is that a job must never be the reason a question
# goes unanswered -- different lock, different unit, different process, and this
# file is the middle one of the three.

[Unit]
Description=Halftone jarvis work runner
Wants=network-online.target
After=network-online.target
# Deliberately no After= or Conflicts= naming halftone-jarvis-say.service. The
# two are meant to be alive at the same time; any ordering between them would be
# a serialisation, which is the exact thing this lane was split out to avoid.

[Service]
Type=oneshot
User=pi
Group=pi
# Jarvis's own project directory, shared with the talk lane, and a permission
# boundary rather than a convenience: its .claude/settings.json is the
# default-deny allowlist that decides what these sessions may run, and claude
# loads that from the working directory. Point this somewhere else and the
# session inherits whatever settings it finds there instead -- which matters
# most here, because this is the lane that runs unattended for half an hour.
WorkingDirectory=/home/pi/halftone-chat/jobenv
ExecStart=/usr/bin/python3 -u /home/pi/halftone-chat/bin/jarvis-job-runner.py
# The runner's own per-job wall is 1800s and it runs strictly one at a time, so
# this is the backstop for a long queue rather than for a long job.
TimeoutStartSec=7200
# Lower priority than the talk lane's Nice=10, and this is the one scheduling
# decision that carries the feature. Two lanes running at once on four cores
# means a job compiling something and an answer being written compete, and if
# the answer loses that race the lanes were separated for nothing: the reader
# gets a slow assistant instead of a blocked one. Jobs wait; people do not.
Nice=15
# A ceiling, not a reservation -- but sized as though the other lane were also
# at its own ceiling, because on this box it may be. Deliberately below the talk
# lane's 4G: if the kernel has to choose, **a wedged job must never be the
# reason an answer gets OOM-killed.**
MemoryMax=3G
# Deliberately no Restart=. The path unit re-fires while the queue is non-empty,
# which is the same retry with a truer trigger: it restarts because work is
# still waiting, not because a process exited.

# The Codex researcher uses its own signed-in CLI home and a temporary
# workspace with a read-only permission profile. It returns structured text;
# the trusted runner publishes the files. JARVIS_JOB_BACKEND=claude selects
# the older worker environment and its existing tool allowlist.
NoNewPrivileges=true
PrivateTmp=yes

# No [Install] section, deliberately. This unit is started by
# halftone-jarvis-job.path, never enabled directly. Omitting [Install] is what
# makes `systemctl enable halftone-jarvis-job.service` fail loudly ("no
# installation config") instead of silently succeeding and running a drain at
# every boot -- a WantedBy= here would do the exact opposite of preventing that.
