# Copy to .env and fill in. .env is gitignored; chmod 600 it.
#
# Every one of these is optional except COLLECTOR_API_TOKEN. A source whose
# secret is missing reports `dormant` -- rendered as "not wired", not as an
# error -- so the collector runs fine with none of the optional ones set and
# you can add them one at a time.

# --- required -----------------------------------------------------------
# Auth for this server. It serves whole-network telemetry and proxies live
# camera stills, so it refuses to start without one of >=24 chars.
# Generate it ON the machine that will serve, never elsewhere and copied:
#
#   echo "COLLECTOR_API_TOKEN=$(openssl rand -hex 32)" >> .env
#
# Command substitution is stored unexpanded in shell history, so that records
# the command rather than the secret.
COLLECTOR_API_TOKEN=

# --- optional -----------------------------------------------------------
# The camera monitor's bearer token, so this process can read its state and
# proxy its camera frame. Same value as MONITOR_API_TOKEN in the camera
# monitor's own .env on this host. Rotating means editing both files and
# restarting both services. (That monitor is a separate service and is not
# part of this repo; the `camera` source stays dormant without it.)
#
# Deliberately a different secret from COLLECTOR_API_TOKEN: browser->collector
# and collector->monitor are different trust boundaries.
MONITOR_API_TOKEN=

# Pi-hole v6 app password -- Settings > Web interface / API > app password.
# NOT your web login: an app password is independently revocable and does not
# double as UI access.
PIHOLE_APP_PASSWORD=

# Shared secret for the voice proxy, forwarded to the TTS host as
# X-Halftone-Key. The name is pinned in collector.py rather than made a config
# knob, because the wire names it on both ends. Voice is off unless BOTH this
# and a `tts.base` in config.json are set: both routes then answer 503, which
# is the feature disabled rather than broken.
HALFTONE_TTS_KEY=

# GitHub personal access token for the commits panel.
# Use a FINE-GRAINED token, read-only, with just:
#   Repository permissions -> Contents: Read-only
#   Repository permissions -> Metadata: Read-only
# and an expiry date. A classic `repo`-scope token grants WRITE to every
# repository the account can reach, which is an enormous over-grant for
# reading five commit subject lines from a file on a Pi.
GITHUB_TOKEN=

# Daily Brief narration. Set the voice ID and API key to enable synthesis on Play.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
