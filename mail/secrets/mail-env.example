# Copy to secrets/mail-env, chmod 600, fill in. Loaded by charon-mail-poll.service
# and charon-mail-actions.service via EnvironmentFile=, and by maillib.load_env()
# when a worker runs by hand. The triage unit NEVER loads this file: the worker
# that runs a model must not be able to see the mailbox credentials, so every
# key in here stays out of secrets/env. See charon-mail-triage.service.

# The mail server. With Stalwart on this Pi behind /etc/hosts, this is the
# mail.<domain> name the certificate is issued for -- not 127.0.0.1, or TLS
# verification cannot match the name.
CHARON_IMAP_HOST=mail.example.com
CHARON_SMTP_HOST=mail.example.com
# Implicit-TLS ports. These are the defaults; set only to override.
#CHARON_IMAP_PORT=993
#CHARON_SMTP_PORT=465

# The mailbox. The address is the IMAP/SMTP login and the From: header unless
# the two optional overrides below say otherwise.
CHARON_MAIL_ADDRESS=agent@example.com
# Used exactly as written: no whitespace stripping, unlike the old
# GMAIL_APP_PASSWORD, which existed only because Google prints app passwords
# with spaces in them.
CHARON_MAIL_PASSWORD=
# Only when the server's login name is not the address itself.
#CHARON_MAIL_USER=
# Only when the From: header should differ from the address. May carry a
# display name: CHARON_MAIL_FROM=Charon <agent@example.com>
#CHARON_MAIL_FROM=

# Where archive moves messages and where sent copies are filed. Created on
# first use when missing. If the server already has special-use folders under
# other names (LIST "" "*" shows them), set these to match instead of growing
# a second set.
#CHARON_ARCHIVE_FOLDER=Archive
#CHARON_SENT_FOLDER=Sent
