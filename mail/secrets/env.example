# Copy to secrets/env, chmod 600, fill in. Loaded by the systemd units via
# EnvironmentFile= and by each worker's maillib.load_env().
#
# This file is the ONLY thing that has to change to move Charon to a different
# model provider. See the repository README.

# ---- which backend -------------------------------------------------------
# claude-cli | anthropic-api | openai-compat
# Unset means claude-cli, which is what the Pi has always run.
CHARON_LLM_PROVIDER=claude-cli

# ---- claude-cli ----------------------------------------------------------
# The CLI's own credential. Generate with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional. Resolved with which(claude) when unset, so this is only needed on a
# box where the binary is somewhere unusual.
#CHARON_CLAUDE_BIN=/home/pi/.local/bin/claude

# ---- anthropic-api -------------------------------------------------------
# Tiers default to claude-sonnet-5 (cheap) and claude-opus-5 (good).
#CHARON_LLM_API_KEY=sk-ant-...

# ---- openai-compat -------------------------------------------------------
# Also reaches OpenRouter, Ollama, LM Studio, vLLM, Groq and Together.
# Both model names are REQUIRED: there is no sensible default for a backend
# that could be any of a dozen services.
#CHARON_LLM_BASE_URL=https://api.openai.com/v1
#CHARON_LLM_API_KEY=sk-...
#CHARON_MODEL_CHEAP=gpt-4o-mini
#CHARON_MODEL_GOOD=gpt-4o

# Local example (Ollama wants a key header but ignores the value):
#CHARON_LLM_BASE_URL=http://localhost:11434/v1
#CHARON_LLM_API_KEY=unused
#CHARON_MODEL_CHEAP=qwen2.5:7b
#CHARON_MODEL_GOOD=qwen2.5:32b

# ---- unrelated to the model ----------------------------------------------
# The mailbox credentials (CHARON_MAIL_*) live in secrets/mail-env, NOT here,
# and the triage unit deliberately does not load that file. See
# charon-mail-triage.service and secrets/mail-env.example.
